{
  "name": "videowhisper-video-conference",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --mode wordpress && node scripts/sync.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:server": "node --test tests/server.test.cjs tests/legacy-room.test.cjs",
    "test:php": "php tests/tickets.test.php && php tests/demo-state.test.php && node --test tests/demo-http.test.cjs",
    "package": "node scripts/package.mjs",
    "test:live": "node tests/live-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.486.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "socket.io": "^4.8.4",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "license": "GPL-2.0-or-later"
}
