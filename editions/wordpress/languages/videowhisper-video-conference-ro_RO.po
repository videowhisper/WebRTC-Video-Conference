#. Plugin Name of the plugin
#: videowhisper-video-conference.php:3
msgid "VideoWhisper Video Conference"
msgstr "VideoWhisper Video Conference"

#. Description of the plugin
#: videowhisper-video-conference.php:4
msgid ""
"Small group WebRTC video meetings with chat, screen sharing and a manually "
"configured signaling server."
msgstr ""
"Întâlniri video WebRTC pentru grupuri mici, cu chat, partajarea ecranului și "
"server de semnalizare configurat manual."

#. Author of the plugin
#: videowhisper-video-conference.php:8
msgid "VideoWhisper.com"
msgstr "VideoWhisper.com"

#. Author URI of the plugin
#: videowhisper-video-conference.php:9
msgid "https://videowhisper.com/"
msgstr "https://videowhisper.com/"

#: includes/labels.php:6
msgid "Anyone with this link can join this public room."
msgstr "Oricine are acest link poate intra în această cameră publică."

#: includes/labels.php:7
msgid ""
"Anyone with this private invitation can join. Keep its access key private."
msgstr ""
"Oricine are această invitație privată poate intra. Păstrează cheia de acces "
"confidențială."

#: includes/labels.php:8
msgid "Ask the meeting owner for an invitation link."
msgstr "Cere organizatorului un link de invitație."

#: includes/labels.php:9
msgid "Browser permission required"
msgstr "Este necesară permisiunea browserului"

#: includes/labels.php:10
msgid ""
"Camera or microphone unavailable. Allow browser access or join without media."
msgstr ""
"Camera sau microfonul nu este disponibil. Permite accesul în browser sau "
"intră fără cameră și microfon."

#: includes/labels.php:11
msgid "Camera preview starts when you join."
msgstr "Previzualizarea camerei începe când intri în întâlnire."

