<?php
/** Generated streaming account client v1; source wordpress/tools/streaming-connect, revision {{REVISION}}. */
namespace {{NAMESPACE}}\StreamingConnect;
defined( 'ABSPATH' ) || exit;

/** Optional CRM onboarding; neither this connection nor a plan label grants meeting access. */
final class Connection {
    private static array $adapter = array();
    public static function boot( array $adapter ): void {
        self::$adapter = $adapter;
        add_action( 'admin_enqueue_scripts', static function () {
            if ( ! current_user_can( 'manage_options' ) ) return;
            $query = array(); wp_parse_str( wp_parse_url( self::$adapter['page'], PHP_URL_QUERY ) ?? '', $query );
            // phpcs:ignore WordPress.Security.NonceVerification.Recommended -- Read-only selection of this product's settings stylesheet.
            $page = isset( $_GET['page'] ) && is_string( $_GET['page'] ) ? sanitize_key( wp_unslash( $_GET['page'] ) ) : '';
            if ( $page === ( $query['page'] ?? '' ) ) wp_enqueue_style( self::$adapter['slug'] . '-streaming-connect', plugins_url( 'class-streaming-connect.css', __FILE__ ), array(), '{{REVISION}}' );
        } );
        add_action( 'admin_post_' . $adapter['action'], array( __CLASS__, 'post' ) );
        add_action( 'rest_api_init', array( __CLASS__, 'register_proof' ), 20 );
        add_filter( 'rest_dispatch_request', static function ( $result, $request, $route ) {
            return null === $result && '/videowhisper-streaming-connect/v1/proof' === $route && 'POST' === $request->get_method() && self::$adapter['slug'] === $request->get_param('plugin') ? self::proof( $request ) : $result;
        }, 10, 3 );
    }
    private static function key(): string { return self::$adapter['option'] . '_' . get_current_blog_id() . '_' . get_current_user_id(); }
    private static function state(): array {
        $value = get_option( self::key(), array() );
        return is_array( $value ) ? $value : array();
    }
    private static function save( array $state ): void { update_option( self::key(), $state, false ); }
    private static function provider(): string { return 'https://consult.videowhisper.com'; }
    private static function failure(): \RuntimeException { return new \RuntimeException( 'connection_request_failed' ); }
    private static function text( array $input, string $key, int $max = 200 ): string {
        $value = $input[ $key ] ?? '';
        if ( ! is_string( $value ) || strlen( $value ) > $max ) throw self::failure();
        return sanitize_text_field( $value );
    }
    /** Credentials remain server-side and may only be sent to the fixed HTTPS CRM origin. */
    private static function request( string $operation, array $body = array() ): array {
        if ( ! in_array( $operation, array( 'config', 'register', 'login', 'confirm', 'accounts', 'account_new', 'settings', 'callback-capabilities', 'callback-provision', 'support-intake' ), true ) ) throw self::failure();
        $url = self::provider() . '/wp-json/video-live-support/v1/remote/' . $operation;
        $args = array( 'timeout' => 20, 'redirection' => 0, 'limit_response_size' => 262144, 'headers' => array( 'Content-Type' => 'application/json', 'Referer' => home_url( '/' ) ) );
        if ( in_array( $operation, array( 'config', 'callback-capabilities' ), true ) ) $response = wp_safe_remote_get( $url, $args );
        else {
            $body['client_plugin'] = self::$adapter['slug'];
            $body['client_site_url'] = home_url( '/' );
            $args['body'] = wp_json_encode( $body );
            $response = wp_safe_remote_post( $url, $args );
        }
        if ( is_wp_error( $response ) || 200 !== wp_remote_retrieve_response_code( $response ) ) throw self::failure();
        $data = json_decode( wp_remote_retrieve_body( $response ), true );
        if ( ! is_array( $data ) || isset( $data['error'] ) || isset( $data['code'] ) ) throw self::failure();
        return $data;
    }
    private static function credentials( array $state ): array {
        if ( empty( $state['consent'] ) || ! is_int( $state['contact_id'] ?? null ) || $state['contact_id'] < 1 ||
            ! is_string( $state['remote_token'] ?? null ) || ! preg_match( '/\A[A-Za-z0-9_.-]{20,512}\z/', $state['remote_token'] ) ||
            ! is_int( $state['expires'] ?? null ) || $state['expires'] <= time() ) throw self::failure();
        return array( 'contact_id' => $state['contact_id'], 'remote_token' => $state['remote_token'] );
    }
    private static function form_config( $data ): array {
        if ( ! is_array( $data ) || ! is_array( $data['form'] ?? null ) || ! is_array( $data['fields'] ?? null ) || count( $data['fields'] ) > 60 ) throw self::failure();
        $form = array( 'fields' => array() );
        foreach ( array( 'name', 'instructions', 'terms', 'termsUrl' ) as $key ) {
            $v = $data['form'][ $key ] ?? '';
            if ( ! is_string( $v ) || strlen( $v ) > 8000 ) throw self::failure();
            $form[ $key ] = 'termsUrl' === $key ? esc_url_raw( $v, array( 'https' ) ) : wp_strip_all_tags( $v );
        }
        foreach ( $data['fields'] as $field ) {
            if ( ! is_array( $field ) || ! is_string( $field['name'] ?? null ) || strlen( $field['name'] ) > 100 || '' === $field['name'] || preg_match( '/[\x00-\x1f\x7f\[\]]/', $field['name'] ) ||
                isset( $form['fields'][ $field['name'] ] ) || ! in_array( $field['type'] ?? 'text', array( 'text', 'textarea', 'select', 'multiselect', 'toggle', 'email', 'url' ), true ) ) throw self::failure();
            $options = $field['options'] ?? array();
            if ( ! is_array( $options ) || count( $options ) > 100 ) throw self::failure();
            foreach ( $options as $option ) if ( ! is_string( $option ) || strlen( $option ) > 500 ) throw self::failure();
            $instructions = $field['instructions'] ?? '';
            $placeholder = $field['placeholder'] ?? '';
            if ( ! is_string( $instructions ) || strlen( $instructions ) > 2000 || ! is_string( $placeholder ) || strlen( $placeholder ) > 500 ) throw self::failure();
            $form['fields'][ $field['name'] ] = array( 'type' => $field['type'] ?? 'text', 'options' => array_values( $options ), 'required' => ! empty( $field['required'] ), 'instructions' => wp_strip_all_tags( $instructions ), 'placeholder' => wp_strip_all_tags( $placeholder ) );
        }
        return $form;
    }
    private static function saved_form(): array {
        $value = get_transient( self::key() . '_form' );
        if ( ! is_array( $value ) || ! is_array( $value['fields'] ?? null ) || count( $value['fields'] ) > 60 ) return array();
        $fields = array();
        foreach ( $value['fields'] as $name => $field ) {
            if ( ! is_string( $name ) || ! is_array( $field ) ) return array();
            $fields[] = array_merge( $field, array( 'name' => $name ) );
        }
        try { return self::form_config( array( 'form' => $value, 'fields' => $fields ) ); }
        catch ( \Throwable $error ) { return array(); }
    }
    private static function accounts( array $response ): array {
        if ( ! is_array( $response['accounts'] ?? null ) || count( $response['accounts'] ) > 200 ) throw self::failure();
        $out = array();
        foreach ( $response['accounts'] as $row ) {
            if ( ! is_array( $row ) || ! is_numeric( $row['id'] ?? null ) || (int) $row['id'] < 1 || ! is_string( $row['name'] ?? null ) ||
                ! preg_match( '/\A[A-Za-z0-9_.-]{1,96}\z/', $row['name'] ) || ! is_string( $row['token'] ?? null ) || strlen( $row['token'] ) < 8 || strlen( $row['token'] ) > 512 ) throw self::failure();
            $out[ (int) $row['id'] ] = $row;
        }
        return $out;
    }
    private static function site_host( string $value ): string {
        $url = str_contains( $value, '://' ) ? $value : 'https://' . $value;
        return preg_replace( '/^www\./', '', strtolower( rtrim( (string) wp_parse_url( $url, PHP_URL_HOST ), '.' ) ) );
    }
    private static function name_matches_site( string $name, string $host ): bool {
        if ( '' === $host ) return false;
        return (bool) preg_match( '/(?:^|[^a-z0-9.])' . preg_quote( $host, '/' ) . '(?:$|[^a-z0-9.])/i', $name )
            || str_ends_with( strtolower( $name ), '.' . $host );
    }
    private static function project_accounts( array $state, array $response, array $accounts ): array {
        $host = self::site_host( home_url( '/' ) );
        $state['accounts'] = array();
        $state['site_accounts'] = array();
        foreach ( $accounts as $id => $account ) {
            $state['accounts'][ $id ] = $account['name'];
            $associations = array( $account['lifecycle']['domain'] ?? null, $account['website'] ?? null, $account['domain'] ?? null, $account['site_url'] ?? null );
            foreach ( $associations as $association ) {
                if ( '' !== $host && is_string( $association ) && strlen( $association ) <= 2048 && self::site_host( $association ) === $host ) {
                    $state['site_accounts'][ $id ] = $host;
                    break;
                }
            }
        }

        $quota = $response['accounts_quota'] ?? null;
        foreach ( array( 'organization_name', 'organization_plan_name' ) as $field ) {
            if ( array_key_exists( $field, $response ) ) $state[ $field ] = self::label( $response[ $field ] );
            elseif ( is_array( $quota ) && array_key_exists( $field, $quota ) ) $state[ $field ] = self::label( $quota[ $field ] );
        }
        // Use provider counts. Listed accounts may exclude other members' accounts, paused projects and paid exemptions.
        unset( $state['quota'] );
        if ( is_array( $quota ) && in_array( $quota['scope'] ?? null, array( 'organization', 'contact', 'unavailable' ), true ) ) {
            $value = array( 'scope' => $quota['scope'] );
            foreach ( array( 'used', 'remaining', 'limit' ) as $field ) {
                if ( array_key_exists( $field, $quota ) && ( null === $quota[ $field ] || ( is_int( $quota[ $field ] ) && $quota[ $field ] >= 0 ) ) ) $value[ $field ] = $quota[ $field ];
            }
            if ( is_bool( $quota['can_create'] ?? null ) ) $value['can_create'] = $quota['can_create'];
            $value['new_account_plan_name'] = self::label( $quota['new_account_plan_name'] ?? $response['new_account_plan_name'] ?? '' );
            $state['quota'] = $value;
        }
        return $state;
    }
    private static function label( $value ): string {
        return is_string( $value ) && strlen( $value ) <= 200 ? sanitize_text_field( $value ) : '';
    }
    private static function selected_id( array $state ): int {
        $id = $state['selected_id'] ?? 0;
        if ( is_int( $id ) && $id > 0 ) return $id;
        if ( ! is_string( $state['selected_name'] ?? null ) || ! is_array( $state['accounts'] ?? null ) ) return 0;
        $matches = array_keys( $state['accounts'], $state['selected_name'], true );
        return 1 === count( $matches ) ? absint( $matches[0] ) : 0;
    }
    private static function account_details( array $account, array $response, array $inspection ): array {
        $info = is_array( $response['account'] ?? null ) ? $response['account'] : array();
        $limits = array();
        foreach ( array(
            'bitrate' => 'Video Bitrate (kbps)', 'audioBitrate' => 'Audio Bitrate (kbps)',
            'width' => 'Max Width', 'height' => 'Max Height', 'frameRate' => 'Max Framerate',
            'connections' => 'Max Connections', 'totalBitrate' => 'Total Bitrate (kbps)',
        ) as $key => $provider_label ) {
            $value = $info['plan'][ $provider_label ] ?? $account['plan_properties'][ $key ] ?? null;
            if ( is_numeric( $value ) && is_finite( (float) $value ) && (float) $value >= 0 && (float) $value <= 1000000000 ) $limits[ $key ] = (float) $value;
        }
        return array(
            'plan_name' => self::label( $info['plan_name'] ?? $account['plan_name'] ?? '' ),
            'limits' => $limits,
            'missing' => $inspection['missing'],
            'different' => $inspection['different'],
            'hosts' => $inspection['hosts'],
            'refreshed' => time(),
        );
    }
    private static function sorted_accounts( array $state ): array {
        $host = self::site_host( home_url( '/' ) );
        $accounts = is_array( $state['accounts'] ?? null ) ? $state['accounts'] : array();
        $local = array(); $other = array();
        foreach ( $accounts as $id => $name ) {
            if ( ! is_string( $name ) ) continue;
            if ( self::site_account( $state, (int) $id, $name, $host ) ) $local[ $id ] = $name;
            else $other[ $id ] = $name;
        }
        return $local + $other;
    }
    private static function quota_summary( array $state ): bool {
        $quota = is_array( $state['quota'] ?? null ) ? $state['quota'] : array();
        echo '<h3>' . esc_html__( 'Create a testing account', '{{DOMAIN}}' ) . '</h3>';
        if ( ! empty( $state['organization_name'] ) ) {
            /* translators: 1: organization name, 2: organization plan name. */
            echo '<p>' . esc_html( sprintf( __( 'Organization: %1$s. Organization plan: %2$s.', '{{DOMAIN}}' ), $state['organization_name'], ( $state['organization_plan_name'] ?? '' ) ?: __( 'Not reported', '{{DOMAIN}}' ) ) ) . '</p>';
        }
        if ( isset( $quota['used'] ) && array_key_exists( 'remaining', $quota ) ) {
            $remaining = null === $quota['remaining'] ? __( 'Unlimited', '{{DOMAIN}}' ) : number_format_i18n( $quota['remaining'] );
            /* translators: 1: free or trial accounts counted by the provider, 2: available new slots. */
            $format = 'organization' === $quota['scope'] ? __( 'Shared organization accounts in use: %1$s. Slots available to you: %2$s.', '{{DOMAIN}}' ) : __( 'Accounts in use under your allowance: %1$s. Slots available: %2$s.', '{{DOMAIN}}' );
            echo '<p>' . esc_html( sprintf( $format, number_format_i18n( $quota['used'] ), $remaining ) ) . '</p>';
        } else {
            echo '<p>' . esc_html__( 'The provider has not reported account availability. Refresh the account list to check again.', '{{DOMAIN}}' ) . '</p>';
        }
        /* translators: %s: account plan name provided by the CRM. */
        echo '<p>' . esc_html( sprintf( __( 'New account plan: %s', '{{DOMAIN}}' ), ( $quota['new_account_plan_name'] ?? '' ) ?: __( 'Confirmed by the provider when the account is created', '{{DOMAIN}}' ) ) ) . '</p>';
        return false !== ( $quota['can_create'] ?? true );
    }
    private static function site_account( array $state, int $id, string $name, string $host ): bool {
        return self::name_matches_site( $name, $host ) || ( '' !== $host && ( $state['site_accounts'][ $id ] ?? null ) === $host );
    }
    private static function proposed_name(): string {
        $host = strtolower( rtrim( (string) wp_parse_url( home_url( '/' ), PHP_URL_HOST ), '.' ) );
        $name = preg_replace( '/^videowhisper-/', '', self::$adapter['slug'] ) . '.' . $host;
        return strlen( $name ) <= 96 && strpos( $host, '.' ) !== false && filter_var( $host, FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME ) && ! filter_var( $host, FILTER_VALIDATE_IP ) ? $name : '';
    }
    /** Validate the adapter settings and project only its callback fields. */
    private static function inspect_account( array $account, array $response ): array {
        $settings = $response['settings'] ?? null;
        if ( ! is_array( $settings ) || ! is_string( $settings['vwsToken'] ?? null ) || ! hash_equals( $account['token'], $settings['vwsToken'] ) || $account['name'] !== ( $settings['vwsAccount'] ?? null ) ) throw self::failure();
        $fingerprints = $response['callback_fingerprints'] ?? array();
        if ( ! is_array( $fingerprints ) ) throw self::failure();
        $desired = call_user_func( self::$adapter['properties'] );
        $expected = array(); $missing = array(); $different = array(); $hosts = array();
        foreach ( $desired as $key => $url ) {
            $found = $fingerprints[ $key ] ?? null;
            $exposed = $settings[ $key ] ?? '';
            if ( ! is_string( $exposed ) || ( null !== $found && ( ! is_string( $found ) || ! preg_match( '/\A[a-f0-9]{64}\z/', $found ) ) ) ) throw self::failure();
            if ( '' !== $exposed ) {
                $value_hash = hash( 'sha256', $exposed );
                if ( null !== $found && ! hash_equals( $found, $value_hash ) ) throw self::failure();
                $found = $value_hash;
            }
            $expected[ $key ] = $found;
            if ( null === $found ) $missing[] = $key;
            elseif ( ! hash_equals( hash( 'sha256', $url ), $found ) ) {
                $different[] = $key;
                $host = wp_parse_url( $exposed, PHP_URL_HOST ) ?: ( $response['callback_hosts'][ $key ] ?? '' );
                $hosts[ $key ] = is_string( $host ) && filter_var( $host, FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME ) ? $host : '';
            }
        }
        if ( isset( self::$adapter['validate'] ) ) call_user_func( self::$adapter['validate'], $settings );
        return compact( 'settings', 'desired', 'expected', 'missing', 'different', 'hosts' );
    }
    private static function capabilities(): array {
        try { $caps = self::request( 'callback-capabilities' ); }
        catch ( \Throwable $error ) { return array(); }
        return 1 === ( $caps['version'] ?? null ) && true === ( $caps['atomic'] ?? null ) && true === ( $caps['site_proof'] ?? null ) && is_array( $caps['products'] ?? null ) && in_array( self::$adapter['slug'], $caps['products'], true ) ? $caps : array();
    }
    private static function review_key(): string { return self::key() . '_callback_review'; }
    private static function review_session( array $credentials ): string {
        return hash_hmac( 'sha256', wp_json_encode( array( $credentials, home_url( '/' ), self::$adapter['slug'] ) ), wp_salt( 'auth' ) );
    }
    private static function provision( array $credentials, array $account, array $inspection, bool $replace ): array {
        if ( ! is_callable( self::$adapter['validate'] ?? null ) ) throw self::failure();
        $capabilities = self::capabilities();
        if ( ! $capabilities || ( $replace && true !== ( $capabilities['reviewed_replacement'] ?? null ) ) ) throw new \RuntimeException( 'provider_update' );
        $properties = $inspection['desired']; $expected = $inspection['expected'];
        $nonce = bin2hex( random_bytes( 24 ) ); $proof_key = bin2hex( random_bytes( 32 ) ); $expires = time() + 90;
        $pending = array( 'nonce' => $nonce, 'expires' => $expires, 'site' => home_url( '/' ), 'provider' => self::provider(), 'plugin' => self::$adapter['slug'], 'account_id' => (int) $account['id'], 'properties_hash' => hash( 'sha256', wp_json_encode( $properties ) ), 'key' => $proof_key, 'user_id' => get_current_user_id() );
        $body = $credentials + array( 'token' => $account['token'], 'plugin' => $pending['plugin'], 'site' => $pending['site'], 'account_id' => $pending['account_id'], 'properties' => $properties, 'expected' => $expected, 'nonce' => $nonce, 'expires' => $expires, 'proof_key' => $proof_key );
        if ( $replace ) {
            $body['replace'] = true;
            $pending['replacement_hash'] = hash( 'sha256', wp_json_encode( $expected ) );
        }
        $proof_name = self::$adapter['option'] . '_proof_' . hash( 'sha256', $nonce );
        if ( ! set_transient( $proof_name, $pending, 90 ) ) throw self::failure();
        try {
            $configured = self::request( 'callback-provision', $body );
            if ( 1 !== ( $configured['version'] ?? null ) || $pending['account_id'] !== ( $configured['account_id'] ?? null ) || $nonce !== ( $configured['nonce'] ?? null ) || ! is_array( $configured['configured'] ?? null ) ) throw self::failure();
            foreach ( $properties as $name => $value ) if ( hash( 'sha256', $value ) !== ( $configured['configured'][ $name ] ?? null ) ) throw self::failure();
            $response = self::request( 'settings', $credentials + array( 'token' => $account['token'] ) );
            $verified = self::inspect_account( $account, $response );
            if ( $verified['missing'] || $verified['different'] ) throw self::failure();
            return array( $verified, $response );
        } finally { delete_transient( $proof_name ); }
    }
    /** Public for owned native regression fixtures; native post() owns capability/nonce handling. */
    public static function perform( string $operation, array $input ): void {
        if ( ! current_user_can( 'manage_options' ) ) throw self::failure();
        $state = self::state();
        if ( 'disconnect' === $operation ) { delete_option( self::key() ); delete_transient( self::review_key() ); return; }
        if ( in_array( $operation, array( 'load', 'login', 'register' ), true ) ) {
            if ( '1' !== ( $input['consent'] ?? '' ) ) throw self::failure();
            if ( 'load' === $operation ) {
                $form = self::form_config( self::request( 'config' ) );
                set_transient( self::key() . '_form', $form, 15 * MINUTE_IN_SECONDS );
                return;
            }
            $email = self::text( $input, 'email' );
            if ( ! is_email( $email ) ) throw self::failure();
            $body = array( 'email' => $email );
            if ( 'register' === $operation ) {
                $form = self::saved_form();
                if ( ! $form || '1' !== ( $input['terms'] ?? '' ) ) throw self::failure();
                $body['name'] = self::text( $input, 'name', 100 );
                if ( strlen( $body['name'] ) < 3 ) throw self::failure();
                $fields = $input['fields'] ?? array();
                if ( ! is_array( $fields ) || array_diff_key( $fields, $form['fields'] ) ) throw self::failure();
                $body['fields'] = array();
                if ( isset( $form['fields']['Website'] ) ) {
                    $body['fields']['Website'] = home_url( '/' );
                }
                foreach ( $form['fields'] as $key => $field ) {
                    if ( 'Website' === $key ) continue;
                    $value = $fields[ $key ] ?? ( 'multiselect' === $field['type'] ? array() : '' );
                    if ( 'multiselect' === $field['type'] ) {
                        if ( ! is_array( $value ) || count( $value ) > 100 ) throw self::failure();
                        foreach ( $value as $choice ) if ( ! is_string( $choice ) || ! in_array( $choice, $field['options'], true ) ) throw self::failure();
                    } elseif ( ! is_string( $value ) || strlen( $value ) > 2000 || ( 'select' === $field['type'] && '' !== $value && ! in_array( $value, $field['options'], true ) ) ) throw self::failure();
                    if ( $field['required'] && ( '' === $value || array() === $value ) ) throw self::failure();
                    $body['fields'][ $key ] = is_array( $value ) ? array_map( 'sanitize_text_field', $value ) : sanitize_textarea_field( $value );
                }
                $current_form = self::form_config( self::request( 'config' ) );
                if ( ! hash_equals( hash( 'sha256', wp_json_encode( $form ) ), hash( 'sha256', wp_json_encode( $current_form ) ) ) ) throw self::failure();
            }
            self::request( $operation, $body );
            self::save( array( 'pending_email' => $email, 'consent' => time() ) );
            return;
        }
        if ( in_array( $operation, array( 'confirm', 'code_login' ), true ) ) {
            // A supplied code goes directly to confirm and never requests a replacement email.
            $email = 'code_login' === $operation ? self::text( $input, 'email' ) : ( $state['pending_email'] ?? '' );
            $consented = 'code_login' === $operation ? '1' === ( $input['consent'] ?? null ) : ! empty( $state['consent'] );
            $pin = self::text( $input, 'pin', 128 );
            if ( ! $consented || ! is_string( $email ) || ! is_email( $email ) || '' === $pin ) throw self::failure();
            $data = self::request( 'confirm', array( 'email' => $email, 'pin' => $pin ) );
            if ( true !== ( $data['confirmed'] ?? false ) ) throw self::failure();
            $next = array( 'contact_id' => $data['contact_id'] ?? null, 'remote_token' => $data['remote_token'] ?? null, 'expires' => $data['remote_token_expires'] ?? null, 'consent' => time() );
            if ( ! is_int( $next['expires'] ) || $next['expires'] < 0 ) throw self::failure();
            $next['expires'] = min( $next['expires'] ?: time() + 30 * DAY_IN_SECONDS, time() + 30 * DAY_IN_SECONDS );
            self::credentials( $next );
            $next = self::project_accounts( $next, $data, self::accounts( $data ) );
            self::save( $next );
            delete_transient( self::review_key() );
            delete_transient( self::key() . '_form' );
            return;
        }
        if ( 'cancel_callback' === $operation ) { delete_transient( self::review_key() ); return; }
        $credentials = self::credentials( $state );
        $selected_actions = array( 'refresh_selected', 'sync_selected', 'callback_selected' );
        if ( ! in_array( $operation, array_merge( array( 'accounts', 'create', 'import', 'provision', 'confirm_callback' ), $selected_actions ), true ) ) throw self::failure();
        $on_selected = in_array( $operation, $selected_actions, true );
        $selected_id = self::selected_id( $state );
        $creation = array();
        if ( 'create' === $operation ) {
            if ( '1' !== ( $input['create_approved'] ?? '' ) ) throw self::failure();
            $creation['website'] = home_url( '/' );
            $proposed = self::proposed_name();
            $caps = self::capabilities();
            if ( '' !== $proposed && true === ( $caps['named_accounts'] ?? null ) ) $creation['proposed_name'] = $proposed;
            elseif ( '1' !== ( $input['allow_legacy_name'] ?? '' ) ) throw new \RuntimeException( 'naming_unavailable' );
        }
        $review = null;
        if ( 'confirm_callback' === $operation ) {
            $review = get_transient( self::review_key() );
            $review_id = self::text( $input, 'review_id', 48 );
            if ( ! is_array( $review ) || '' === $review_id || ! hash_equals( $review['id'], $review_id ) ||
                ! hash_equals( $review['session'], self::review_session( $credentials ) ) ) throw new \RuntimeException( 'callback_changed' );
            delete_transient( self::review_key() );
        }
        $response = self::request( 'create' === $operation ? 'account_new' : 'accounts', $credentials + $creation );
        $accounts = self::accounts( $response );
        $state = self::project_accounts( $state, $response, $accounts );
        if ( $on_selected || in_array( $operation, array( 'import', 'provision', 'confirm_callback' ), true ) ) {
            $id = $review ? (string) $review['account_id'] : ( $on_selected ? (string) $selected_id : self::text( $input, 'account_id', 12 ) );
            if ( ! ctype_digit( $id ) || ! isset( $accounts[ (int) $id ] ) ) throw self::failure();
            $account = $accounts[ (int) $id ];
            $details = self::request( 'settings', $credentials + array( 'token' => $account['token'] ) );
            $inspection = self::inspect_account( $account, $details );
            if ( 'refresh_selected' === $operation ) {
                $state['selected_id'] = (int) $id;
                $state['selected_name'] = $account['name'];
                $state['account_details'] = self::account_details( $account, $details, $inspection );
                self::save( $state );
                return;
            }
            if ( 'confirm_callback' === $operation ) {
                if ( $review['expected'] !== $inspection['expected'] || $review['desired'] !== $inspection['desired'] ||
                    $review['account_name'] !== $account['name'] || ! hash_equals( $review['account_hash'], hash( 'sha256', $account['token'] ) ) ) throw new \RuntimeException( 'callback_changed' );
                list( $inspection, $details ) = self::provision( $credentials, $account, $inspection, true );
            } elseif ( $inspection['different'] ) {
                $caps = self::capabilities();
                $next = array(
                    'id' => bin2hex( random_bytes( 24 ) ), 'session' => self::review_session( $credentials ),
                    'account_id' => (int) $id, 'account_name' => $account['name'], 'account_hash' => hash( 'sha256', $account['token'] ),
                    'expected' => $inspection['expected'], 'desired' => $inspection['desired'],
                    'hosts' => $inspection['hosts'], 'different' => $inspection['different'], 'missing' => $inspection['missing'],
                    'available' => true === ( $caps['reviewed_replacement'] ?? null ),
                );
                if ( ! set_transient( self::review_key(), $next, 10 * MINUTE_IN_SECONDS ) ) throw self::failure();
                return; // A callback conflict always pauses for review, including ordinary import.
            } elseif ( in_array( $operation, array( 'provision', 'callback_selected' ), true ) && $inspection['missing'] ) {
                list( $inspection, $details ) = self::provision( $credentials, $account, $inspection, false );
            }
            call_user_func( self::$adapter['import'], $inspection['settings'] );
            $state['callback_required'] = $inspection['missing'];
            $state['selected_id'] = (int) $id;
            $state['selected_name'] = $account['name'];
            $state['account_details'] = self::account_details( $account, $details, $inspection );
            delete_transient( self::review_key() );
        }
        if ( 'create' === $operation ) {
            unset( $state['created_name'] );
            $created = $response['account']['id'] ?? 0;
            if ( is_int( $created ) && isset( $accounts[ $created ] ) ) $state['created_name'] = $accounts[ $created ]['name'];
        }
        self::save( $state );
    }
    private static function support_inventory( array $input ): array {
        $all = '1' === ( $input['all_plugins'] ?? '' );
        if ( ! $all && '1' !== ( $input['videowhisper_plugins'] ?? '' ) ) return array();
        require_once ABSPATH . 'wp-admin/includes/plugin.php';
        $plugins = array();
        foreach ( get_plugins() as $file => $metadata ) {
            $name = sanitize_text_field( $metadata['Name'] ?? '' );
            $is_video_whisper = false !== stripos( ( $metadata['Author'] ?? '' ) . ' ' . ( $metadata['AuthorURI'] ?? '' ), 'videowhisper' );
            if ( '' === $name || ( ! $all && ! $is_video_whisper ) ) continue;
            $plugins[] = array(
                'name' => wp_check_invalid_utf8( substr( $name, 0, 180 ) ),
                'version' => wp_check_invalid_utf8( substr( sanitize_text_field( $metadata['Version'] ?? '' ), 0, 60 ) ),
                'status' => is_plugin_active_for_network( $file ) ? 'network-active' : ( is_plugin_active( $file ) ? 'active' : 'inactive' ),
            );
            if ( count( $plugins ) >= 300 ) break;
        }
        return $plugins ? array( ( $all ? 'all_plugins' : 'videowhisper_plugins' ) => $plugins ) : array();
    }

    public static function support_review_url( array $input ): string {
        $state = self::state();
        $message = $input['message'] ?? '';
        if ( ! is_string( $message ) || strlen( $message ) > 10000 ) throw self::failure();
        $result = self::request( 'support-intake', self::credentials( $state ) + array(
            'account_id' => self::selected_id( $state ),
            'message' => sanitize_textarea_field( $message ),
        ) + self::support_inventory( $input ) );
        $url = $result['review_url'] ?? null;
        $prefix = self::provider() . '/?vws_support_review=1#vws-draft=';
        if ( ! is_string( $url ) || ! str_starts_with( $url, $prefix ) || ! preg_match( '/\A[a-f0-9]{64}\z/', substr( $url, strlen( $prefix ) ) ) ) throw self::failure();
        return $url;
    }

    public static function post(): void {
        if ( ! current_user_can( 'manage_options' ) ) wp_die( esc_html__( 'You cannot manage this connection.', '{{DOMAIN}}' ), '', array( 'response' => 403 ) );
        if ( ! isset( $_SERVER['REQUEST_METHOD'] ) || ! is_string( $_SERVER['REQUEST_METHOD'] ) || 'post' !== sanitize_key( wp_unslash( $_SERVER['REQUEST_METHOD'] ) ) ) wp_die( esc_html__( 'POST is required.', '{{DOMAIN}}' ), '', array( 'response' => 405 ) );
        check_admin_referer( self::$adapter['action'] );
        $message = 'success'; $operation = '';
        try {
            // phpcs:ignore WordPress.Security.ValidatedSanitizedInput.InputNotSanitized -- perform() validates every field by operation before use.
            $input = wp_unslash( $_POST );
            $operation = self::text( $input, 'operation', 30 );
            if ( 'support' === $operation ) {
                $url = self::support_review_url( $input );
                nocache_headers();
                header( 'Referrer-Policy: no-referrer' );
                $allow = static fn( $hosts ) => array_merge( $hosts, array( wp_parse_url( self::provider(), PHP_URL_HOST ) ) );
                add_filter( 'allowed_redirect_hosts', $allow );
                wp_safe_redirect( $url, 303 );
                remove_filter( 'allowed_redirect_hosts', $allow );
                exit;
            }
            if ( 'import' === $operation && '1' === ( $input['configure_callback'] ?? '' ) ) $operation = 'provision';
            self::perform( $operation, $input );
        } catch ( \Throwable $error ) { $message = in_array( $error->getMessage(), array( 'provider_update', 'callback_changed', 'naming_unavailable' ), true ) ? $error->getMessage() : 'failed'; }
        $query = array( 'connection_result' => $message, 'contact' => in_array( $operation, array( 'load', 'register' ), true ) ? 'new' : 'existing' );
        if ( 'support' === $operation ) $query = array( 'connect_view' => 'support', 'connection_result' => 'support_failed' );
        if ( in_array( $operation, array( 'accounts', 'create' ), true ) || ( 'success' !== $message && in_array( $operation, array( 'import', 'provision' ), true ) ) ) $query['accounts'] = '1';
        wp_safe_redirect( add_query_arg( $query, admin_url( self::$adapter['page'] ) ) );
        exit;
    }
    public static function register_proof(): void {
        if ( ! isset( rest_get_server()->get_routes()['/videowhisper-streaming-connect/v1/proof'] ) ) register_rest_route( 'videowhisper-streaming-connect/v1', '/proof', array( 'methods' => 'POST', 'permission_callback' => '__return_true', 'callback' => array( __CLASS__, 'proof' ) ) );
    }
    public static function proof( \WP_REST_Request $request ) {
        $data = $request->get_json_params();
        $deny = new \WP_Error( 'vwconf_callback_proof', __( 'Callback website proof rejected.', '{{DOMAIN}}' ), array( 'status' => 403 ) );
        if ( strlen($request->get_body()) > 8192 || ! is_array($data) || 1 !== ($data['version'] ?? null) || ! is_string($data['nonce'] ?? null) || ! preg_match('/\A[a-f0-9]{48}\z/', $data['nonce']) ) return $deny;
        $pending = get_transient( self::$adapter['option'] . '_proof_' . hash('sha256', $data['nonce']) );
        if ( ! is_array($pending) || ! user_can($pending['user_id'] ?? 0, 'manage_options') || ! is_int($data['expires'] ?? null) || $data['expires'] < time() || $data['expires'] > time() + 120 ) return $deny;
        foreach (array('nonce','expires','site','provider','plugin','account_id','properties_hash') as $field) if (($data[$field] ?? null) !== ($pending[$field] ?? null)) return $deny;
        if ($pending['site'] !== home_url('/') || $pending['provider'] !== self::provider() || $pending['plugin'] !== self::$adapter['slug']) return $deny;
        if ( ( $data['replacement_hash'] ?? null ) !== ( $pending['replacement_hash'] ?? null ) ) return $deny;
        $text = implode("\n", array('vws-streaming-callback-v1',$data['nonce'],$data['expires'],$data['site'],$data['provider'],$data['plugin'],$data['account_id'],$data['properties_hash']));
        if ( isset( $pending['replacement_hash'] ) ) $text .= "\n" . $pending['replacement_hash'];
        return new \WP_REST_Response(array('proof'=>hash_hmac('sha256',$text,$pending['key'])),200,array('Cache-Control'=>'private, no-store'));
    }
    private static function form( string $operation ): void {
        echo '<form method="post" action="' . esc_url( admin_url( 'admin-post.php' ) ) . '"><input type="hidden" name="action" value="' . esc_attr( self::$adapter['action'] ) . '"><input type="hidden" name="operation" value="' . esc_attr( $operation ) . '">';
        wp_nonce_field( self::$adapter['action'] );
    }
    private static function consent(): void {
        echo '<p><label><input type="checkbox" name="consent" value="1" required> ' . esc_html__( 'I agree to send this website and plugin identifier, my contact details and selected registration answers to VideoWhisper CRM for account setup and support.', '{{DOMAIN}}' ) . '</label></p>';
    }
    private static function contact_tabs( string $selected ): void {
        echo '<nav class="nav-tab-wrapper" aria-label="' . esc_attr__( 'Contact options', '{{DOMAIN}}' ) . '">';
        foreach ( array( 'existing' => __( 'Existing contact', '{{DOMAIN}}' ), 'new' => __( 'New contact', '{{DOMAIN}}' ) ) as $key => $label ) {
            echo '<a class="nav-tab ' . ( $selected === $key ? 'nav-tab-active' : '' ) . '" ' . ( $selected === $key ? 'aria-current="page"' : '' ) . ' href="' . esc_url( add_query_arg( 'contact', $key, admin_url( self::$adapter['page'] ) ) ) . '">' . esc_html( $label ) . '</a>';
        }
        echo '</nav>';
    }
    private static function contact_fields( bool $name = false, bool $code = false ): void {
        $prefix = self::$adapter['slug'] . ( $code ? '-code-' : '-contact-' );
        echo '<table class="form-table" role="presentation"><tbody>';
        if ( $name ) echo '<tr><th scope="row"><label for="' . esc_attr( $prefix . 'name' ) . '">' . esc_html__( 'Name', '{{DOMAIN}}' ) . '</label></th><td><input class="regular-text" id="' . esc_attr( $prefix . 'name' ) . '" name="name" minlength="3" maxlength="100" autocomplete="name" required></td></tr>';
        echo '<tr><th scope="row"><label for="' . esc_attr( $prefix . 'email' ) . '">' . esc_html__( 'Email', '{{DOMAIN}}' ) . '</label></th><td><input class="regular-text" id="' . esc_attr( $prefix . 'email' ) . '" type="email" name="email" autocomplete="email" maxlength="200" required></td></tr>';
        if ( $code ) echo '<tr><th scope="row"><label for="' . esc_attr( $prefix . 'pin' ) . '">' . esc_html__( 'PIN or login code', '{{DOMAIN}}' ) . '</label></th><td><input id="' . esc_attr( $prefix . 'pin' ) . '" name="pin" type="password" autocomplete="one-time-code" maxlength="128" required></td></tr>';
        echo '</tbody></table>';
    }
    private static function links(): void {
        echo '<footer class="vws-connect-footer"><a href="https://www.videowhisper.com/view.php?p=Terms+of+Use" target="_blank" rel="noopener noreferrer">' . esc_html__( 'Provider terms', '{{DOMAIN}}' ) . '</a><a href="https://www.videowhisper.com/view.php?p=Privacy+Policy" target="_blank" rel="noopener noreferrer">' . esc_html__( 'Provider privacy policy', '{{DOMAIN}}' ) . '</a><a href="' . esc_url( add_query_arg( array( 'Website' => home_url( '/' ), 'Plugin' => self::$adapter['slug'] ), self::provider() . '/' ) ) . '" target="_blank" rel="noopener noreferrer">' . esc_html__( 'Contact support', '{{DOMAIN}}' ) . '</a></footer>';
    }
    private static function render_callback_review( array $state ): void {
        $review = get_transient( self::review_key() );
        try { $credentials = self::credentials( $state ); }
        catch ( \Throwable $error ) { return; }
        if ( ! is_array( $review ) || ! hash_equals( $review['session'], self::review_session( $credentials ) ) ) return;
        echo '<div class="vws-connect-card" id="vws-callback-review"><h3>' . esc_html__( 'Review callback changes', '{{DOMAIN}}' ) . '</h3>';
        /* translators: %s: streaming account name. */
        echo '<p>' . esc_html( sprintf( __( 'Streaming account: %s', '{{DOMAIN}}' ), $review['account_name'] ) ) . '</p>';
        echo '<p>' . esc_html__( 'Replacing a callback can interrupt applications that use the previous address. Confirm this streaming account is ready to use with this installation.', '{{DOMAIN}}' ) . '</p><dl>';
        foreach ( array_merge( $review['different'], $review['missing'] ) as $property ) {
            $host = $review['hosts'][ $property ] ?? '';
            if ( $host ) {
                /* translators: %s: hostname of the provider account's current callback. */
                $current = sprintf( __( 'Currently configured on %s', '{{DOMAIN}}' ), $host );
            } else {
                $current = in_array( $property, $review['missing'], true ) ? __( 'Currently empty', '{{DOMAIN}}' ) : __( 'A different address is configured', '{{DOMAIN}}' );
            }
            echo '<dt><strong>' . esc_html( $property ) . '</strong></dt><dd>' . esc_html( $current ) . '<br>' . esc_html__( 'Proposed callback', '{{DOMAIN}}' ) . ' <code>' . esc_html( $review['desired'][ $property ] ) . '</code></dd>';
        }
        echo '</dl>';
        if ( $review['available'] ) {
            self::form( 'confirm_callback' );
            echo '<input type="hidden" name="review_id" value="' . esc_attr( $review['id'] ) . '"><p><button class="button button-primary">' . esc_html__( 'Confirm and replace callback', '{{DOMAIN}}' ) . '</button></p></form>';
        } else {
            echo '<p>' . esc_html__( 'The provider needs an update before this change can be confirmed here. Contact support to review the callback on your account.', '{{DOMAIN}}' ) . '</p>';
        }
        self::form( 'cancel_callback' );
        echo '<button class="button">' . esc_html__( 'Dismiss callback review', '{{DOMAIN}}' ) . '</button></form></div>';
    }
    private static function render_selected_account( array $state ): void {
        $details = is_array( $state['account_details'] ?? null ) ? $state['account_details'] : array();
        $limits = array(
            'bitrate' => __( 'Video bitrate limit (kbps)', '{{DOMAIN}}' ),
            'audioBitrate' => __( 'Audio bitrate limit (kbps)', '{{DOMAIN}}' ),
            'width' => __( 'Maximum video width', '{{DOMAIN}}' ),
            'height' => __( 'Maximum video height', '{{DOMAIN}}' ),
            'frameRate' => __( 'Maximum frame rate', '{{DOMAIN}}' ),
            'connections' => __( 'Maximum connections', '{{DOMAIN}}' ),
            'totalBitrate' => __( 'Total bitrate limit (kbps)', '{{DOMAIN}}' ),
        );
        echo '<div class="vws-connect-card"><h3>' . esc_html__( 'Connected streaming account', '{{DOMAIN}}' ) . '</h3><dl class="vws-connect-detail">';
        echo '<dt>' . esc_html__( 'Account name', '{{DOMAIN}}' ) . '</dt><dd><strong>' . esc_html( $state['selected_name'] ) . '</strong></dd>';
        echo '<dt>' . esc_html__( 'Streaming plan', '{{DOMAIN}}' ) . '</dt><dd>' . esc_html( ( $details['plan_name'] ?? '' ) ?: __( 'Refresh account details to retrieve the current plan.', '{{DOMAIN}}' ) ) . '</dd>';
        foreach ( $limits as $key => $label ) {
            if ( isset( $details['limits'][ $key ] ) && is_numeric( $details['limits'][ $key ] ) ) {
                $number = (float) $details['limits'][ $key ];
                echo '<dt>' . esc_html( $label ) . '</dt><dd>' . esc_html( number_format_i18n( $number, floor( $number ) === $number ? 0 : 2 ) ) . '</dd>';
            }
        }
        foreach ( call_user_func( self::$adapter['properties'] ) as $key => $url ) {
            $status = __( 'Refresh account details to check the provider callback.', '{{DOMAIN}}' );
            if ( $details ) {
                $status = __( 'Configured for this site', '{{DOMAIN}}' );
                if ( in_array( $key, $details['missing'], true ) ) $status = __( 'Callback setup required', '{{DOMAIN}}' );
                elseif ( in_array( $key, $details['different'], true ) ) {
                    $host = $details['hosts'][ $key ] ?? '';
                    /* translators: %s: hostname of the currently configured callback. */
                    $status = $host ? sprintf( __( 'A different callback is configured on %s', '{{DOMAIN}}' ), $host ) : __( 'A different callback is configured', '{{DOMAIN}}' );
                }
            }
            echo '<dt>' . esc_html( $key ) . '</dt><dd>' . esc_html( $status ) . '<br><code>' . esc_html( $url ) . '</code></dd>';
        }
        if ( ! empty( $details['refreshed'] ) ) echo '<dt>' . esc_html__( 'Last refreshed', '{{DOMAIN}}' ) . '</dt><dd>' . esc_html( wp_date( get_option( 'date_format' ) . ' ' . get_option( 'time_format' ), (int) $details['refreshed'] ) ) . '</dd>';
        echo '</dl><div class="vws-connect-actions">';
        foreach ( array(
            'refresh_selected' => __( 'Refresh account details', '{{DOMAIN}}' ),
            'sync_selected' => __( 'Sync streaming settings', '{{DOMAIN}}' ),
            'callback_selected' => __( 'Review or configure callback', '{{DOMAIN}}' ),
        ) as $operation => $label ) {
            self::form( $operation );
            echo '<button class="button">' . esc_html( $label ) . '</button></form>';
        }
        echo '</div><p><a href="' . esc_url( add_query_arg( 'accounts', '1', admin_url( self::$adapter['page'] ) ) ) . '">' . esc_html__( 'Switch or create an account', '{{DOMAIN}}' ) . '</a></p></div>';
    }
    private static function render_support(): void {
        echo '<div class="vws-connect-card"><h3>' . esc_html__( 'Request setup or account support', '{{DOMAIN}}' ) . '</h3><p>' . esc_html__( 'Describe what you need. Review the assigned department, its fields and the details you selected before sending the request in VideoWhisper.', '{{DOMAIN}}' ) . '</p>';
        self::form( 'support' );
        echo '<table class="form-table" role="presentation"><tbody><tr><th scope="row"><label for="vw-streaming-support-message">' . esc_html__( 'Message', '{{DOMAIN}}' ) . '</label></th><td><textarea class="large-text" id="vw-streaming-support-message" name="message" rows="6" maxlength="10000"></textarea></td></tr>';
        echo '<tr><th scope="row">' . esc_html__( 'Optional site details', '{{DOMAIN}}' ) . '</th><td><fieldset><legend class="screen-reader-text">' . esc_html__( 'Optional site details', '{{DOMAIN}}' ) . '</legend>';
        echo '<label><input type="checkbox" name="videowhisper_plugins" value="1"> ' . esc_html__( 'VideoWhisper plugins, versions and activation status', '{{DOMAIN}}' ) . '</label><br>';
        echo '<label><input type="checkbox" name="all_plugins" value="1"> ' . esc_html__( 'All installed plugins, versions and activation status', '{{DOMAIN}}' ) . '</label>';
        echo '</fieldset></td></tr></tbody></table><button class="button button-primary">' . esc_html__( 'Review support request on VideoWhisper', '{{DOMAIN}}' ) . '</button></form></div>';
    }

    public static function render(): void {
        if ( ! current_user_can( 'manage_options' ) ) return;
        $state = self::state();
        echo '<section class="vws-streaming-connect"><h2>' . esc_html__( 'Connect to VideoWhisper', '{{DOMAIN}}' ) . '</h2><p>' . esc_html__( 'Optional turnkey setup: request a free trial streaming account where offered, or connect an existing paid account and configure compatible settings automatically. Manual server settings remain available without connecting. Availability, quotas and trial terms are determined by the provider.', '{{DOMAIN}}' ) . '</p>';
        // phpcs:ignore WordPress.Security.NonceVerification.Recommended -- Read-only allowlisted status message, no state change.
        $result = isset( $_GET['connection_result'] ) && is_string( $_GET['connection_result'] ) ? sanitize_key( wp_unslash( $_GET['connection_result'] ) ) : '';
        if ( 'provider_update' === $result ) echo '<div class="notice notice-warning inline"><p><strong>' . esc_html( self::$adapter['name'] ?? self::$adapter['slug'] ) . ': </strong>' . esc_html__( 'This provider needs the safe callback provisioning update. No callback or manual setting was changed. Use manual setup or ask the provider to enable the atomic callback API.', '{{DOMAIN}}' ) . '</p></div>';
        if ( 'failed' === $result ) echo '<div class="notice notice-error inline"><p><strong>' . esc_html( self::$adapter['name'] ?? self::$adapter['slug'] ) . ': </strong>' . esc_html__( 'The request failed. Check the email code, selected account and provider availability. If you were configuring a callback, start a new review to verify the current value. Existing meeting settings were retained.', '{{DOMAIN}}' ) . '</p></div>';
        if ( 'support_failed' === $result ) echo '<div class="notice notice-error inline"><p>' . esc_html__( 'The support draft could not be prepared. Check the connection and try again.', '{{DOMAIN}}' ) . '</p></div>';
        if ( 'callback_changed' === $result ) echo '<div class="notice notice-warning inline"><p>' . esc_html__( 'The callback review expired or the account changed. Select the account again to review its current callback.', '{{DOMAIN}}' ) . '</p></div>';
        if ( 'naming_unavailable' === $result ) echo '<div class="notice notice-warning inline"><p>' . esc_html__( 'The provider could not use the proposed account name. You can retry with the default account name if you approve that option below.', '{{DOMAIN}}' ) . '</p></div>';
        if ( isset( $state['pending_email'] ) ) {
            echo '<div class="vws-connect-card"><h3>' . esc_html__( 'Confirm your email', '{{DOMAIN}}' ) . '</h3>';
            self::form( 'confirm' );
            echo '<p>' . esc_html__( 'Check your email for the latest code. Confirmation may finish creating the account requested during registration.', '{{DOMAIN}}' ) . '</p><table class="form-table" role="presentation"><tbody><tr><th scope="row"><label for="vws-connect-pin">' . esc_html__( 'Email confirmation or login code', '{{DOMAIN}}' ) . '</label></th><td><input id="vws-connect-pin" name="pin" type="password" autocomplete="one-time-code" maxlength="128" required></td></tr></tbody></table><button class="button button-primary">' . esc_html__( 'Confirm email and finish account setup', '{{DOMAIN}}' ) . '</button></form></div>';
        } elseif ( isset( $state['remote_token'] ) ) {
            if ( ! is_int( $state['expires'] ?? null ) || $state['expires'] <= time() ) echo '<div class="notice notice-warning inline"><p><strong>' . esc_html( self::$adapter['name'] ?? self::$adapter['slug'] ) . ': </strong>' . esc_html__( 'This CRM login session expired. Disconnect it below, then request a new email code. Imported manual settings continue to work.', '{{DOMAIN}}' ) . '</p></div>';
            // phpcs:ignore WordPress.Security.NonceVerification.Recommended -- Read-only connection subtab.
            $support = isset( $_GET['connect_view'] ) && is_string( $_GET['connect_view'] ) && 'support' === sanitize_key( wp_unslash( $_GET['connect_view'] ) );
            $settings = admin_url( self::$adapter['page'] );
            echo '<nav class="nav-tab-wrapper" aria-label="' . esc_attr__( 'VideoWhisper connection', '{{DOMAIN}}' ) . '"><a class="nav-tab' . ( $support ? '' : ' nav-tab-active' ) . '" href="' . esc_url( $settings ) . '">' . esc_html__( 'Account', '{{DOMAIN}}' ) . '</a><a class="nav-tab' . ( $support ? ' nav-tab-active' : '' ) . '" href="' . esc_url( add_query_arg( 'connect_view', 'support', $settings ) ) . '">' . esc_html__( 'Support', '{{DOMAIN}}' ) . '</a></nav>';
            if ( $support ) {
                self::render_support();
                echo '</section>';
                return;
            }
            self::render_callback_review( $state );
            // phpcs:ignore WordPress.Security.NonceVerification.Recommended -- This flag only changes the rendered panel.
            $picker = isset( $_GET['accounts'] ) && '1' === $_GET['accounts'];
            $has_selection = ! empty( $state['selected_name'] ) && self::selected_id( $state );
            if ( $has_selection && ! $picker ) {
                self::render_selected_account( $state );
            } else {
            if ( $has_selection ) echo '<p><a href="' . esc_url( admin_url( self::$adapter['page'] ) ) . '">' . esc_html__( 'Back to connected account', '{{DOMAIN}}' ) . '</a></p>';
            echo '<div class="vws-connect-card"><h3>' . esc_html__( 'Your streaming accounts', '{{DOMAIN}}' ) . '</h3><table class="widefat striped vws-connect-accounts"><thead><tr><th scope="col">' . esc_html__( 'Streaming account', '{{DOMAIN}}' ) . '</th><th scope="col">' . esc_html__( 'Setup', '{{DOMAIN}}' ) . '</th></tr></thead><tbody>';
            $host = self::site_host( home_url( '/' ) );
            foreach ( self::sorted_accounts( $state ) as $id => $name ) {
                $match = self::site_account( $state, (int) $id, $name, $host );
                echo '<tr class="' . esc_attr( $match ? 'vws-connect-site-account' : '' ) . '"><td><strong>' . esc_html( $name ) . '</strong>';
                if ( $match ) echo ' <span class="vws-connect-site-label">' . esc_html__( 'Related to this site', '{{DOMAIN}}' ) . '</span>';
                echo '</td><td>'; self::form( 'import' );
                echo '<input type="hidden" name="account_id" value="' . absint( $id ) . '"><p class="vws-connect-actions"><button class="button">' . esc_html__( 'Use this account', '{{DOMAIN}}' ) . '</button><button class="button button-primary" name="configure_callback" value="1">' . esc_html__( 'Use account and configure callback', '{{DOMAIN}}' ) . '</button></p></form></td></tr>';
            }
            echo '</tbody></table>'; self::form( 'accounts' ); echo '<p><button class="button">' . esc_html__( 'Refresh account list', '{{DOMAIN}}' ) . '</button></p></form>';
            if ( self::quota_summary( $state ) ) {
                $proposed = self::proposed_name();
                if ( $proposed ) echo '<p><strong>' . esc_html__( 'Proposed account name', '{{DOMAIN}}' ) . '</strong> <code>' . esc_html( $proposed ) . '</code></p>';
                if ( isset( $state['created_name'] ) ) {
                    /* translators: %s: account name returned after an account creation request. */
                    echo '<p>' . esc_html( sprintf( __( 'Account returned by the provider: %s', '{{DOMAIN}}' ), $state['created_name'] ) ) . '</p>';
                }
                self::form( 'create' );
                echo '<p><label><input type="checkbox" name="allow_legacy_name" value="1"> ' . esc_html__( 'Allow the provider’s default name if it cannot use the proposed name.', '{{DOMAIN}}' ) . '</label></p>';
                echo '<p><label><input type="checkbox" name="create_approved" value="1" required> ' . esc_html__( 'Create a testing account for this website under the provider’s current free-account terms and quota. This may send an account email. Existing domain accounts are not replaced.', '{{DOMAIN}}' ) . '</label></p><button class="button">' . esc_html__( 'Create testing account', '{{DOMAIN}}' ) . '</button></form>';
            } else {
                echo '<p>' . esc_html__( 'The provider is not offering another testing account for this contact right now.', '{{DOMAIN}}' ) . '</p>';
            }
            echo '</div>';
            }
        } else {
            // phpcs:ignore WordPress.Security.NonceVerification.Recommended -- Read-only contact subtab; switching tabs never contacts the provider.
            $selected = isset( $_GET['contact'] ) && is_string( $_GET['contact'] ) && 'new' === sanitize_key( wp_unslash( $_GET['contact'] ) ) ? 'new' : 'existing';
            self::contact_tabs( $selected ); echo '<div class="vws-connect-card">';
            if ( 'existing' === $selected ) {
                echo '<h3>' . esc_html__( 'Existing VideoWhisper contact', '{{DOMAIN}}' ) . '</h3>'; self::form( 'login' ); self::contact_fields(); self::consent();
                echo '<button class="button button-primary">' . esc_html__( 'Email a login code', '{{DOMAIN}}' ) . '</button></form>';
                echo '<h3>' . esc_html__( 'Already have a code?', '{{DOMAIN}}' ) . '</h3>';
                self::form( 'code_login' ); self::contact_fields( false, true ); self::consent();
                echo '<button class="button">' . esc_html__( 'Connect with this code', '{{DOMAIN}}' ) . '</button></form>';
            } else {
                echo '<h3>' . esc_html__( 'New contact', '{{DOMAIN}}' ) . '</h3>'; $form = self::saved_form();
                if ( ! $form ) {
                    self::form( 'load' ); self::consent(); echo '<button class="button button-primary">' . esc_html__( 'Load registration form', '{{DOMAIN}}' ) . '</button></form>';
                } else {
                    echo '<h4>' . esc_html( $form['name'] ) . '</h4><p>' . esc_html( $form['instructions'] ) . '</p>'; self::form( 'register' ); self::contact_fields( true );
                    echo '<table class="form-table" role="presentation"><tbody>';
                    foreach ( $form['fields'] as $name => $field ) {
                        $id = self::$adapter['slug'] . '-field-' . substr( hash( 'sha256', $name ), 0, 12 );
                        if ( 'Website' === $name ) { echo '<tr><th scope="row">' . esc_html__( 'Website', '{{DOMAIN}}' ) . '</th><td><code>' . esc_html( home_url( '/' ) ) . '</code></td></tr>'; continue; }
                        if ( 'multiselect' === $field['type'] ) {
                            echo '<tr><th scope="row" id="' . esc_attr( $id ) . '">' . esc_html( $name ) . '</th><td><fieldset class="vws-connect-choices" aria-labelledby="' . esc_attr( $id ) . '">';
                            foreach ( $field['options'] as $option ) {
                                echo '<label><input type="checkbox" name="fields[' . esc_attr( $name ) . '][]" value="' . esc_attr( $option ) . '"> ' . esc_html( $option ) . '</label>';
                            }
                            if ( $field['required'] ) echo '<p class="description">' . esc_html__( 'Select at least one option.', '{{DOMAIN}}' ) . '</p>';
                            if ( $field['instructions'] ) echo '<p class="description">' . esc_html( $field['instructions'] ) . '</p>';
                            echo '</fieldset></td></tr>';
                            continue;
                        }
                        echo '<tr><th scope="row"><label for="' . esc_attr( $id ) . '">' . esc_html( $name ) . '</label></th><td>';
                        if ( 'select' === $field['type'] ) {
                            echo '<select id="' . esc_attr( $id ) . '" name="fields[' . esc_attr( $name ) . ']"' . ( $field['instructions'] ? ' aria-describedby="' . esc_attr( $id . '-help' ) . '"' : '' ) . '>';
                            foreach ( $field['options'] as $option ) echo '<option value="' . esc_attr( $option ) . '">' . esc_html( $option ) . '</option>';
                            echo '</select>';
                        } elseif ( 'textarea' === $field['type'] ) echo '<textarea id="' . esc_attr( $id ) . '" name="fields[' . esc_attr( $name ) . ']" maxlength="2000"' . ( $field['instructions'] ? ' aria-describedby="' . esc_attr( $id . '-help' ) . '"' : '' ) . '></textarea>';
                        else echo '<input id="' . esc_attr( $id ) . '" name="fields[' . esc_attr( $name ) . ']" type="' . ( 'toggle' === $field['type'] ? 'checkbox' : 'text' ) . '" ' . ( 'toggle' === $field['type'] ? 'value="1"' : '' ) . ' maxlength="2000"' . ( $field['instructions'] ? ' aria-describedby="' . esc_attr( $id . '-help' ) . '"' : '' ) . '>';
                        if ( $field['instructions'] ) echo '<p class="description" id="' . esc_attr( $id . '-help' ) . '">' . esc_html( $field['instructions'] ) . '</p>';
                        echo '</td></tr>';
                    }
                    echo '</tbody></table>'; self::consent();
                    echo '<p>' . esc_html( $form['terms'] ?? '' ) . '</p><p><label><input type="checkbox" name="terms" value="1" required> ' . esc_html__( 'I accept the displayed registration terms and request a free testing account for this website where offered.', '{{DOMAIN}}' ) . '</label></p><button class="button button-primary">' . esc_html__( 'Register with VideoWhisper', '{{DOMAIN}}' ) . '</button>';
                    if ( ! empty( $form['termsUrl'] ) ) echo '<p><a href="' . esc_url( $form['termsUrl'] ) . '" target="_blank" rel="noopener noreferrer">' . esc_html__( 'Registration terms', '{{DOMAIN}}' ) . '</a></p>';
                    echo '</form>';
                }
            }
            echo '</div>';
        }
        if ( $state ) {
            self::form( 'disconnect' );
            echo '<p><button class="button">' . esc_html__( 'Disconnect CRM session', '{{DOMAIN}}' ) . '</button></p><p>' . esc_html__( 'Disconnecting removes this administrator’s local CRM session only. Imported manual settings, meetings and provider accounts are retained; remote session retention and revocation follow provider policy.', '{{DOMAIN}}' ) . '</p></form>';
        }
        self::links(); echo '</section>';
    }
}
